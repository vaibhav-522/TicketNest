PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/ticketnest
JWT_SECRET=replace-this-with-a-long-random-secret
CLIENT_URL=http://localhost:5173
# Optional: Razorpay test keys to enable real payments (UPI, cards, netbanking).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Integration API keys (server-to-server only, sent as X-API-Key).
# Generate each one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
SHOWS_API_KEY=
BOOKINGS_API_KEY=
TICKETS_API_KEY=
